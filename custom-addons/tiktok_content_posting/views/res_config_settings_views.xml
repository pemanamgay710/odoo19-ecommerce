<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_tiktok_content_posting" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.tiktok.content.posting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="TikTok Content Posting" name="tiktok_content_posting">
                    <block title="TikTok Content Posting">

                        <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
                            <img src="/tiktok_content_posting/static/src/img/tiktok_logo.png?v=3"
                                 alt="TikTok Logo"
                                 style="height:48px; width:auto; display:block;"/>
                            <div class="o_form_label">TikTok Content Posting Configuration</div>
                        </div>

                        <setting string="TikTok Client Key">
                            <field name="tiktok_client_key"/>
                        </setting>

                        <setting string="TikTok Client Secret">
                            <field name="tiktok_client_secret" password="True"/>
                        </setting>

                        <setting string="TikTok Redirect URI">
                            <field name="tiktok_redirect_uri"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>