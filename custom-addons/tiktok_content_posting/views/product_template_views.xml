<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_tiktok_content_posting" model="ir.ui.view">
        <field name="name">product.template.form.tiktok.content.posting</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="TikTok">
                    <group string="TikTok Inputs">
                        <field name="tiktok_video" filename="tiktok_video_filename"/>
                        <field name="tiktok_video_filename"/>
                        <field name="tiktok_product_url"/>
                    </group>

                    <group string="TikTok Output">
                        <field name="tiktok_publish_id" readonly="1"/>
                        <field name="tiktok_last_status" readonly="1"/>
                        <field name="tiktok_last_message" readonly="1"/>
                    </group>

                    <group>
                        <button name="action_tiktok_upload_draft"
                                type="object"
                                string="Upload Draft to TikTok"
                                class="btn btn-primary"/>

                        <button name="action_tiktok_check_status"
                                type="object"
                                string="Check TikTok Status"
                                class="btn btn-secondary"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>